# app
NEXT_PUBLIC_APP_URL = "https://weddingcrestdesign.com"
NEXT_PUBLIC_APP_NAME = "Wedding Crest Design"

# theme
NEXT_PUBLIC_THEME = "default"

# appearance
NEXT_PUBLIC_APPEARANCE = "system"

# auth secret
# openssl rand -base64 32
AUTH_SECRET = "replace-with-openssl-rand-base64-32"

# database
DATABASE_PROVIDER = "postgresql"
DATABASE_URL = ""
DB_SCHEMA = "wedding-crest"
DB_SCHEMA_FILE = "./src/config/db/schema.postgres.ts"
DB_MIGRATIONS_SCHEMA = "wedding-crest"
DB_MIGRATIONS_OUT = "./src/config/db/migrations_postgres"
DB_SINGLETON_ENABLED = "true"
DB_MAX_CONNECTIONS = "10"

# AI model overrides for the wedding-crest generator. Both default to
# Runware's flux-schnell (text-to-image) and google:nano-banana@2-lite
# (multimodal — used whenever the project carries a reference image such
# as the chosen example, a frame/border, or an uploaded personal photo).
# Override if your Runware account uses a different AIR id.
WEDDING_AI_MODEL = ""
WEDDING_AI_MULTIMODAL_MODEL = ""

# Output dimensions for the text-to-image (flux-schnell) path. Default
# 1024x1024 works on every Runware AIR id. Some models also accept 2048
# for print-quality output, but a few cap at 1024 or 1536 and silently
# return 5xx. Set BOTH env vars explicitly after confirming the model
# supports the size (start with 1536 if unsure). The multimodal
# (nano-banana) path ignores these — Runware rejects "either
# referenceImages or width/height, not both" — so the multimodal
# output size is set by the model itself.
WEDDING_AI_WIDTH = ""
WEDDING_AI_HEIGHT = ""
